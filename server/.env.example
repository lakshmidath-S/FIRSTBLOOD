# Postgres connection string from Neon / Supabase (free tier). Must be a
# Postgres that allows creating extensions (cube, earthdistance) — both
# Neon and Supabase do.
DATABASE_URL="postgresql://user:password@host:5432/firstblood?sslmode=require"

# Any long random strings — used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_too"

PORT=4000
# CORS + Socket.io allowlist. Comma-separate multiple origins if you need
# both, e.g. local dev + a deployed Vercel client:
#   CLIENT_ORIGIN="http://localhost:5173,https://firstblood.vercel.app"
# Leave unset to allow any origin (fine for local dev, not recommended once deployed).
CLIENT_ORIGIN="http://localhost:5173"

# Donors are only matched if the mobile app is installed (a browser tab that's
# closed can't be alerted). Set to "false" for a web-only demo, or while
# migrating an existing donor base onto the app.
REQUIRE_DONOR_MOBILE_APP=true

# The OTP is echoed back in the API response because no SMS gateway is wired
# up. That's fine locally; in production it would hand anyone a session for any
# phone number, so it's off unless explicitly enabled. Set NODE_ENV=production
# on your host and leave this unset.
# EXPOSE_OTP_IN_RESPONSE=false

# --- Mobile push notifications (optional) ---
# Firebase service-account JSON for the Flutter app's FCM pushes. Leave empty
# and push is silently disabled — sockets keep working, so the web client and
# a foregrounded mobile app are unaffected. Paste either the raw JSON or (much
# easier in a hosting dashboard, which mangles multi-line values) its base64:
#   base64 -w0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=""

# Pick ONE: "gemini" or "groq" — both have free tiers.
LLM_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
